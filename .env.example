# Copie para .env (nunca versionado) e preencha os valores vazios.
# Referência: specs/03-architecture.md, seção 9. Valores preenchidos aqui são padrões não sensíveis.

# --- OpenAI (ambos os serviços) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_TIMEOUT=30s
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_TIMEOUT=15s

# --- PostgreSQL + pgvector (api-conhecimento e infra/docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=coti_ai
POSTGRES_USER=coti
POSTGRES_PASSWORD=

# --- api-conhecimento ---
# Mínimo de 16 caracteres; a api-conhecimento não inicia sem ele.
ADMIN_API_TOKEN=
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RAG_SIMILARITY_THRESHOLD=0.70

# --- api-atendimentos ---
MCP_CONHECIMENTO_URL=http://localhost:8081
MCP_REQUEST_TIMEOUT=10s
RAG_TOP_K=5
RAG_CONTEXTO_MAX_CARACTERES=12000
# Comentada: definida vazia, anularia o texto padrão do contrato (06-api-contracts.md, seção 5.1).
# ATENDIMENTO_MENSAGEM_FALLBACK=

# --- ambos os serviços ---
SERVER_ADDRESS=127.0.0.1
LOG_FORMAT=ecs
